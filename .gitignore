# Lo que producen el OCR y la transcripción: cada alumno genera el suyo
salidas/*
!salidas/.gitkeep

# Documentos y audios propios de los alumnos (los ejemplos sí se versionan)
documentos/*
!documentos/README.md
!documentos/ejemplos/
audio/*
!audio/README.md
!audio/ejemplos/

# Modelos de voz: se bajan la primera vez (más de 800 MB)
modelos/*
!modelos/README.md

# Entornos y basura del sistema
.venv/
venv/
__pycache__/
.DS_Store
~$*
